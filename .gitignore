# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Local secrets - never commit the real .env
.env
*.env.local

# Database and uploaded files
db.sqlite3
db.sqlite3-journal
media/*
staticfiles/*

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Scratch and test leftovers
*.log
.coverage
htmlcov/
.pytest_cache/

# The two folders above must still exist in a fresh clone
!media/.gitkeep
!staticfiles/.gitkeep
