# ------------------------------------------------------------------
# KAGAN OWACHO CBO - environment configuration
# Copy this file to ".env" (same folder) and fill in the values.
# Never commit the real .env file.
# ------------------------------------------------------------------

# --- Core Django ---------------------------------------------------
# Generate your own long random key for production.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required in production, e.g. https://kaganowacho.pythonanywhere.com
# On Render you can leave both empty: RENDER_EXTERNAL_HOSTNAME is added to them
# automatically by config/settings.py.
CSRF_TRUSTED_ORIGINS=

# --- Database ------------------------------------------------------
# Leave empty to use the bundled SQLite file (zero setup on a laptop).
# To use PostgreSQL just set this, e.g.
# DATABASE_URL=postgres://user:password@localhost:5432/kagan_cbo
DATABASE_URL=

# --- Uploaded files --------------------------------------------------
# filesystem = uploads land in ./media (right for a laptop).
# database   = uploads are stored in the database and served back through
#              /media/ - needed on hosts with no persistent disk (Render).
MEDIA_STORAGE=filesystem

# --- Organization identity ----------------------------------------
ORGANIZATION_NAME=KAGAN OWACHO CBO
MEMBERSHIP_PREFIX=KOC

# --- The two fixed administrator accounts --------------------------
# Created automatically on the first "python manage.py migrate".
ADMIN1_EMAIL=admin1@kaganowacho.org
ADMIN1_PASSWORD=AdminOne#2026
ADMIN2_EMAIL=admin2@kaganowacho.org
ADMIN2_PASSWORD=AdminTwo#2026

# --- Email (SMTP) --------------------------------------------------
# Gmail example: EMAIL_HOST_USER = you@gmail.com and
# EMAIL_HOST_PASSWORD = a 16-character Gmail App Password (not the account password).
# Leave EMAIL_HOST empty while developing: emails are printed to the console.
# On a live site an empty EMAIL_HOST means nobody receives a code - the registration
# page says so, and the log carries an "Email configuration" warning at every start.
EMAIL_HOST=
EMAIL_PORT=587
# Exactly one of these may be True: port 587 uses TLS (STARTTLS), port 465 uses SSL.
# Setting EMAIL_USE_SSL=True alone is enough - EMAIL_USE_TLS then defaults to False.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Must be the same address as EMAIL_HOST_USER, or a verified alias of it. Gmail
# rewrites or refuses a From it does not own, so mail can be accepted and never arrive.
DEFAULT_FROM_EMAIL=Kagan Owacho CBO <no-reply@kaganowacho.org>
# Where admin notifications (incidents, member blast replies) go:
ADMIN_INBOX_EMAIL=admin1@kaganowacho.org
# Seconds to wait for the mail server before giving up. A slow server must not
# freeze the registration page.
EMAIL_TIMEOUT=10
# Diagnose a live mail problem with:  python manage.py send_test_email you@example.com

# --- Verification codes -------------------------------------------
# A member confirms their email with a 6-digit code. These are the defaults.
VERIFICATION_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# --- SMS: Africa's Talking (optional extra) ------------------------
# Codes always go by email. SMS is only sent in addition when ALL of
# SMS_PROVIDER=africastalking plus the username and API key below are set.
# The site works with email alone, so leave this as console to skip SMS.
SMS_PROVIDER=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=KAGANOWACHO

# --- M-Pesa Daraja (Safaricom) ------------------------------------
# MPESA_ENV = sandbox while testing, production when live.
# You get consumer key/secret from https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a public https URL once deployed, e.g.
# MPESA_CALLBACK_URL=https://your-site.com/contributions/mpesa/callback/
MPESA_CALLBACK_URL=http://localhost:8000/contributions/mpesa/callback/

# --- Security tuning (optional, sensible defaults already set) -----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
